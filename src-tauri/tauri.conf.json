{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Courtsmall",
  "version": "0.3.1",
  "identifier": "io.github.arthurwang322.courtsmall",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Courtsmall",
        "width": 360,
        "height": 176,
        "minWidth": 300,
        "minHeight": 110,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://site.api.espn.com https://sports.core.api.espn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "Sports",
    "shortDescription": "Basketball, but small.",
    "longDescription": "An unofficial desktop companion that follows live NBA games in a quiet corner of your screen.",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../NOTICE": "NOTICE.txt",
      "../LICENSES/OFL-1.1.txt": "OFL-1.1.txt"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCRTJFMUVEQkY3NjdBODIKUldTQ2VuYS83ZUhpK3dNWi9sK2pyajVrWmtqWGthdmZpeUt5bHNNK3dXWnUzRFJEMG8xNnZ0NUIK",
      "endpoints": [
        "https://github.com/ArthurWang322/Courtsmall/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
